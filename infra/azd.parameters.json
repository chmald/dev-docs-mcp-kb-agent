{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=}" },
    "workload": { "value": "${WORKLOAD_NAME=ddmcp}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "deployFallbackServer": { "value": "${DEPLOY_FALLBACK_SERVER=false}" },
    "searchSku": { "value": "${SEARCH_SKU=basic}" },
    "embeddingModelName": { "value": "${EMBEDDING_MODEL_NAME=text-embedding-3-large}" },
    "embeddingModelVersion": { "value": "${EMBEDDING_MODEL_VERSION=1}" },
    "embeddingCapacity": { "value": "${EMBEDDING_CAPACITY=30}" },
    "chatModelName": { "value": "${CHAT_MODEL_NAME=gpt-5-mini}" },
    "chatModelVersion": { "value": "${CHAT_MODEL_VERSION=2025-08-07}" },
    "chatCapacity": { "value": "${CHAT_CAPACITY=150}" },
    "deployHybridModels": { "value": "${DEPLOY_HYBRID_MODELS=true}" },
    "visionModelName": { "value": "${VISION_MODEL_NAME=gpt-4.1}" },
    "visionModelVersion": { "value": "${VISION_MODEL_VERSION=2025-04-14}" },
    "visionCapacity": { "value": "${VISION_CAPACITY=1000}" },
    "frontierModelName": { "value": "${FRONTIER_MODEL_NAME=gpt-5.6-sol}" },
    "frontierModelVersion": { "value": "${FRONTIER_MODEL_VERSION=2026-07-09}" },
    "frontierCapacity": { "value": "${FRONTIER_CAPACITY=200}" }
  }
}
