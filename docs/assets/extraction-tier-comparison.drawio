<mxfile host="Electron" version="26.0.0"><diagram id="tier-compare" name="Extraction tier comparison"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="-6" width="935" height="6" as="geometry"/></mxCell><mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="955" y="-6" width="725" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Tier CU vs Tier DI+: same rows, different trade-offs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Content Understanding vs Document Intelligence Layout + vision skill. Chunk and table figures are measured on the 119-page document; coverage on the 1,025-page corpus. Source: docs/08-extraction-tier-comparison.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1660" height="26" as="geometry"/></mxCell><mxCell id="laneL" value="Tier CU: Content Understanding" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="810" as="geometry"/></mxCell><mxCell id="laneR" value="Tier DI+: Document Intelligence Layout + vision skill" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="680" height="810" as="geometry"/></mxCell><mxCell id="laneL__tag0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="649" y="91" width="61" height="18" as="geometry"/></mxCell><mxCell id="l0" value="&lt;b&gt;300-page hard reject&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;InputPageCountExceeded: the input file has 906 pages, maximum allowed is 300&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="640" height="82" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;No page ceiling&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Every document over 300 pages routes here&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="156" width="640" height="82" as="geometry"/></mxCell><mxCell id="c0" value="Page limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="156" width="220" height="82" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;119 pages (11.6%)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;1 of 2 documents ingested; the 906-page document is rejected&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="640" height="82" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;All 1,025 pages&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The 906-page document ingested in about 45 minutes with zero failures&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="248" width="640" height="82" as="geometry"/></mxCell><mxCell id="c1" value="Corpus coverage (1,025 pages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="248" width="220" height="82" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;100% intact (132/132)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;No table split mid-way&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="640" height="82" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;76.7% intact (56/73)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;About 23% of tables split, losing the header row&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="640" height="82" as="geometry"/></mxCell><mxCell id="c2" value="Tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="220" height="82" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;Described natively&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;21 chunks (8.9%) carry an image description; no empty figure tags&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=media-file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="640" height="82" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Vision skill verbalizes them&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Layout alone leaves 19 of 44 figure chunks as empty &amp;lt;figure&amp;gt;&amp;lt;/figure&amp;gt; shells; the gpt-4.1 skill describes them (167 image-description rows on the 906-page document)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=media-file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="432" width="640" height="82" as="geometry"/></mxCell><mxCell id="c3" value="Figures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="432" width="220" height="82" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;236 chunks, 204–2,317 chars&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Average 1,338 characters; 3 chunks under 300 characters&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="524" width="640" height="82" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;149 chunks, 34–6,116 chars&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Average 2,077 characters; 17 chunks under 300 characters&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="524" width="640" height="82" as="geometry"/></mxCell><mxCell id="c4" value="Chunking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="524" width="220" height="82" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;Page range&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Cannot misattribute a section&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="616" width="640" height="82" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;Heading path&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;21.7% wrong parent (5 of 23 determinable)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="616" width="640" height="82" as="geometry"/></mxCell><mxCell id="c5" value="Citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="616" width="220" height="82" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;$5.00 list price&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Content Understanding Standard; Minimal $0.01, Basic $1.00&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="708" width="640" height="82" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;$10.00 list price&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Document Intelligence Layout; the vision skill is billed separately in Foundry tokens&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="708" width="640" height="82" as="geometry"/></mxCell><mxCell id="c6" value="Cost per 1,000 pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="708" width="220" height="82" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;Skill GA; features in preview&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;ContentUnderstandingSkill is GA (REST 2026-04-01); semantic chunking and figure-description parameters are PREVIEW; CU service GA status is unresolved in Microsoft docs&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="640" height="82" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;Both skills GA&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The Document Intelligence Layout skill and ChatCompletionSkill (vision) are generally available&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="640" height="82" as="geometry"/></mxCell><mxCell id="c7" value="Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1DFDD;strokeColor=#201F1E;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="800" width="220" height="82" as="geometry"/></mxCell><mxCell id="l7__tag0" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="629" y="791" width="61" height="18" as="geometry"/></mxCell><mxCell id="l7__tag1" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="595" y="791" width="30" height="18" as="geometry"/></mxCell><mxCell id="r7__tag0" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1600" y="791" width="30" height="18" as="geometry"/></mxCell><mxCell id="reco" value="&lt;b&gt;Recommendation: route by page count, split oversized PDFs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Up to 300 pages goes to Tier CU. Over 300 pages: --split is the default and cuts the file into parts of at most 300 pages (use 100 for figure-dense content), so every part qualifies for Tier CU. --no-split is for the routing demo only: it sends over-300-page documents to Tier DI+. --upload with neither flag refuses an over-300-page document.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=2.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="1620" height="104" as="geometry"/></mxCell><mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1046" width="60" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_DEFAULT" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="90" y="1047" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_DEFAULT" value="the path the demo takes by default" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="157" y="1046" width="219" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_GA" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="390" y="1047" width="30" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_GA" value="generally available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="426" y="1046" width="128" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_PREVIEW" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="568" y="1047" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_PREVIEW" value="preview API or feature: say so to the customer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="635" y="1046" width="293" height="20" as="geometry"/></mxCell><mxCell id="rs_lx0" value="" style="rounded=1;arcSize=20;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="942" y="1049" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt0" value="differs between the tiers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="974" y="1046" width="164" height="20" as="geometry"/></mxCell><mxCell id="rs_lx1" value="" style="rounded=1;arcSize=20;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1152" y="1049" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt1" value="recommendation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1184" y="1046" width="97" height="20" as="geometry"/></mxCell><mxCell id="rs_footer" value="Developer Docs MCP Knowledge Agent | extraction tier comparison | v1.2.1 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1660" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>