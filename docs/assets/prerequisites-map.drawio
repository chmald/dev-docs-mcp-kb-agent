        <mxCell id="tl45" value="&lt;b&gt;Total ≈ $120–175 / month at POC scale on Basic tier&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;≈ $300–350 / month with Standard S1 instead&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Rough order-of-magnitude — run the azure-pricing-model skill for a customer-specific breakdown before quoting&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="820" height="100" as="geometry"/></mxCell>
        <mxCell id="tl46" value="&lt;b&gt;Pre-flight — do not start docs/03 until all 7 gates are checked&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;1 tenant + subscription · 2 resource providers · 3 region · 4 model quota&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;5 Search capacity + MCP · 6 Storage / Key Vault reachability · 7 Copilot Chat&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Search capacity and Storage network access have each cost a real build&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFBEB;strokeColor=#B7791F;strokeWidth=1.5;fontSize=12;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="860" y="820" width="820" height="100" as="geometry"/></mxCell>
