        <mxCell id="n_cu" value="&lt;b&gt;Tier CU — why it is preferred&lt;/b&gt;&lt;br&gt;• 100% of tables kept intact&lt;br&gt;• figures verbalized&lt;br&gt;• about half the list price&lt;br&gt;• cites by page range&lt;br&gt;• &lt;b&gt;hard limit: 300 pages per file&lt;/b&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1FAF1;strokeColor=#107C10;strokeWidth=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;">
          <mxGeometry x="30" y="620" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_di" value="&lt;b&gt;Tier DI+ — the capability fallback&lt;/b&gt;&lt;br&gt;• no practical page ceiling&lt;br&gt;• Layout + Split + GA vision skill fills the figure gap&lt;br&gt;• cites the deepest heading&lt;br&gt;• a late failure loses the whole document's enrichment" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F3FB;strokeColor=#5C2D91;strokeWidth=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;">
          <mxGeometry x="450" y="620" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_split" value="&lt;b&gt;Why --split is the default choice&lt;/b&gt;&lt;br&gt;• every part qualifies for Tier CU&lt;br&gt;• a vision failure costs one part, not a 900-page manual&lt;br&gt;• part names keep ORIGINAL page numbers, so citations stay correct" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF9F8;strokeColor=#605E5C;strokeWidth=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;">
          <mxGeometry x="880" y="620" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n_free" value="&lt;b&gt;Inverted vs. a confidence cascade&lt;/b&gt;&lt;br&gt;Content Understanding is cheaper &lt;i&gt;and&lt;/i&gt; better here, so Document Intelligence is not tier 1 — it only takes what CU structurally cannot accept." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B7791F;strokeWidth=1;fontSize=12;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;">
