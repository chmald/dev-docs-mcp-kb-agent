="1340" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="t5_3" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#038387&quot;&gt;&lt;b&gt;≈ $16–19&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;One-time total, hybrid (both tiers)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1640" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="876" width="60" height="20" as="geometry"/></mxCell><mxCell id="rs_lx0" value="" style="rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="90" y="879" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt0" value="measured value" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="122" y="876" width="97" height="20" as="geometry"/></mxCell><mxCell id="rs_lx1" value="" style="rounded=1;arcSize=20;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="879" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt1" value="list price or cost estimate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="265" y="876" width="177" height="20" as="geometry"/></mxCell><mxCell id="src" value="Sources: docs/08-extraction-tier-comparison.md and docs/09-findings-and-lessons.md, both last upda