<mxfile host="Electron" version="26.0.0"><diagram id="numbers" name="Numbers that matter"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="975" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="-6" width="1078" height="6" as="geometry"/></mxCell><mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1098" y="-6" width="842" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;The numbers that matter: limits, latency and failure modes measured in this demo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Key figures from the extraction-tier comparison and the findings log, grouped by product. Every value is quoted from docs/08 and docs/09." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1920" height="26" as="geometry"/></mxCell><mxCell id="g0" value="Content Understanding" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=16;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="620" height="360" as="geometry"/></mxCell><mxCell id="t0_0" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;300 pages&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Hard page limit per file; the 906-page document is rejected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="164" width="280" height="128" as="geometry"/></mxCell><mxCell id="t0_1" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;0 → 78&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;CU-tier figure rows on the same document after the fix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="350" y="164" width="280" height="128" as="geometry"/></mxCell><mxCell id="t0_2" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;100%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Tables intact (132/132) on the 119-page document&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="306" width="280" height="128" as="geometry"/></mxCell><mxCell id="t0_3" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;$5.00&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;List price per 1,000 pages (Standard)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="350" y="306" width="280" height="128" as="geometry"/></mxCell><mxCell id="g1" value="Document Intelligence" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=16;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="675" y="100" width="620" height="360" as="geometry"/></mxCell><mxCell id="t1_0" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#5C2D91&quot;&gt;&lt;b&gt;$10.00&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Prebuilt Layout list price per 1,000 pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="695" y="164" width="280" height="128" as="geometry"/></mxCell><mxCell id="t1_1" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#5C2D91&quot;&gt;&lt;b&gt;76.7%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Tables intact (56/73) on the 119-page document&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="995" y="164" width="280" height="128" as="geometry"/></mxCell><mxCell id="t1_2" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#5C2D91&quot;&gt;&lt;b&gt;21.7%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Citations asserting the wrong parent heading&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="695" y="306" width="280" height="128" as="geometry"/></mxCell><mxCell id="t1_3" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#5C2D91&quot;&gt;&lt;b&gt;19 of 44&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Figure-bearing chunks left as empty shells&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="995" y="306" width="280" height="128" as="geometry"/></mxCell><mxCell id="g2" value="Azure OpenAI vision (gpt-4.1)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F1FAF1;strokeColor=#107C10;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=16;fontColor=#107C10;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=azure-openai;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="620" height="360" as="geometry"/></mxCell><mxCell id="t2_0" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#107C10&quot;&gt;&lt;b&gt;6.6–7.5 s&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Per-call latency at detail: high&lt;/font&gt;" style="rounde