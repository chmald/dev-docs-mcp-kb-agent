1"><mxGeometry x="1640" y="306" width="280" height="128" as="geometry"/></mxCell><mxCell id="g3" value="AI Search ingestion" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=16;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="620" height="360" as="geometry"/></mxCell><mxCell id="t3_0" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;0&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Default maxFailedItems in AI Search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="544" width="280" height="128" as="geometry"/></mxCell><mxCell id="t3_1" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;maxFailedItems the indexers set (5 per batch)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="350" y="544" width="280" height="128" as="geometry"/></mxCell><mxCell id="t3_2" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;4 docs, 45 min&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Healthy documents blocked by one transient failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="50" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="t3_3" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#0078D4&quot;&gt;&lt;b&gt;$0.101 / h&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;AI Search Basic (1 SU), about $73.73 a month&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="350" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="g4" value="First deployment audit" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=16;fontColor=#CA5010;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="675" y="480" width="620" height="360" as="geometry"/></mxCell><mxCell id="t4_0" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#CA5010&quot;&gt;&lt;b&gt;4/4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Golden-set pass declared working&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="695" y="544" width="280" height="128" as="geometry"/></mxCell><mxCell id="t4_1" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#CA5010&quot;&gt;&lt;b&gt;27%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Table-bearing chunks split mid-table&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="995" y="544" width="280" height="128" as="geometry"/></mxCell><mxCell id="t4_2" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#CA5010&quot;&gt;&lt;b&gt;36%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Figure-bearing chunks discarded as empty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="695" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="t4_3" value="&lt;font style=&quot;font-size:28px&quot; color=&quot;#CA5010&quot;&gt;&lt;b&gt;41%&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#605E5C&quot;&gt;Determinable heading pairs with the wrong parent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#323130;align=center;verticalAlign=middle;arcSize=8;fontFamily=Segoe UI;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="995" y="686" width="280" height="128" as="geometry"/></mxCell><mxCell id="g5" value="Corpus and one-time cost" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF8F8;strokeColor=#038387;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=1