        <mxCell id="tl16" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;RBAC permission model,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;soft-delete 7 days&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Vault Succeeded&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="475" y="312" width="270" height="112" as="geometry"/></mxCell>
