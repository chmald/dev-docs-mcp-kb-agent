        <mxCell id="tl18" value="&lt;b&gt;Search admin key secret&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Store the key as the secret&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;search-admin-key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Secret present (or documented policy fallback)&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="775" y="312" width="270" height="112" as="geometry"/></mxCell>
