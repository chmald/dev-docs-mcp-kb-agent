        <mxCell id="tl14" value="&lt;b&gt;AI Search (Basic)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Azure AI Search → + Create&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Settings → Semantic ranker → Enable&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Semantic ranker enabled&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1375" y="160" width="270" height="112" as="geometry"/></mxCell>
