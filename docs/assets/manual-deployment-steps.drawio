        <mxCell id="tl34" value="&lt;b&gt;Ingest the corpus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;upload_documents.py → Blob Storage&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;post_deploy_search.py → AI Search&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Indexer run shows 0 failed docs&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;iconKey=blob-block;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="ct35" value="Phase 3 — Knowledge Base + MCP · 30–60 min" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#605E5C;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="540" height="197" as="geometry"/></mxCell>
