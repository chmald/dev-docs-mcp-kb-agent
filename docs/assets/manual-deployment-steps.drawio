        <mxCell id="title" value="&lt;b&gt;Manual deployment steps — Bicep-free runbook&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Phases 0–5 of docs/03b-manual-deployment.md. Manual replaces Phase 1 and Phase 4 only; Phases 2, 3 and 5 are unchanged from the Bicep path." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1660" height="26" as="geometry"/></mxCell>
        <mxCell id="ct1" value="Phase 0 — Auth · 2 min" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="360" height="197" as="geometry"/></mxCell>
        <mxCell id="p2" value="UNCHANGED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#8A8886;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="295" y="111" width="73" height="18" as="geometry"/></mxCell>
        <mxCell id="tl3" value="&lt;b&gt;Authenticate to the right tenant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;set tenant + subscription explicitly&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ az account show matches target&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="320" height="112" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;At a glance&lt;/b&gt;&lt;br&gt;Use when Bicep/ARM is blocked, no Bicep CLI is available, or you want each resource created visibly.&lt;br&gt;Replaces Phase 1 and Phase 4 only.&lt;br&gt;~3.5–4.5 h hands-on, 30–45 min longer than Bicep." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;dashed=1;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="317" width="360" height="142" as="geometry"/></mxCell>
        <mxCell id="i5" value="i" style="ellipse;whiteSpace=wrap;html=1;fillColor=#C8A400;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="32" y="377" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="ct6" value="Phase 1 (manual) — Foundation resources · 45–60 min" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="1240" height="359" as="geometry"/></mxCell>
        <mxCell id="p7" value="MANUAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1613" y="111" width="55" height="18" as="geometry"/></mxCell>
        <mxCell id="tl8" value="&lt;b&gt;Resource group&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Resource groups → + Create&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Resource group exists&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="475" y="160" width="270" height="112" as="geometry"/></mxCell>
        <mxCell id="b9" value="1.0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="465" y="150" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="tl10" value="&lt;b&gt;Storage + raw container&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Storage accounts → + Create,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;then Containers → + Container raw&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ raw container, access Private&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=storage;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="775" y="160" width="270" height="112" as="geometry"/></mxCell>
        <mxCell id="b11" value="1.1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;spacing=0;" vertex="1" parent="1"><mxGeometry x="765" y="150" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="tl12" value="&lt;b&gt;Foundry account + project&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Multi-service account, create a project&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Deployments → + Deploy model ×4&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#107C10&quot;&gt;&lt;b&gt;✓ Project exists, 4 model deployments&lt;/b&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1075" y="160" width="270" height="112" as="geometry"/></mxCell>
