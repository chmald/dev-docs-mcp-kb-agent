<mxfile host="Electron" agent="DailyDriver" version="26.0.0">
  <diagram id="dev-docs-mcp-knowledge-agent-architecture" name="Reference Architecture">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
