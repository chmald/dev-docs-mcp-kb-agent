        </mxCell>
        <mxCell id="doc_note" value="No sample corpus bundled.&#10;See samples/README.md.&#10;&#10;Check vendor redistribution&#10;rights before including a&#10;datasheet in a shared demo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6" vertex="1" parent="1">
