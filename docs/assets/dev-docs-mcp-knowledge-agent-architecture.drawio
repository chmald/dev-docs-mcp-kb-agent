        </mxCell>
        <mxCell id="search_index" value="AI Search Index&#10;idx-documents" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/app_services/Search_Services.svg;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
