          <mxGeometry x="330" y="560" width="270" height="90" as="geometry" />
        </mxCell>

        <!-- ============ Tier 3 — Platform ============ -->
        <mxCell id="foundry_box" value="Microsoft Foundry multi-service account&#10;(kind: AIServices) &#8212; one resource,&#10;one endpoint, one RBAC surface" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C2D91;dashed=1;verticalAlign=top;fontStyle=1;fontSize=10;fontColor=#5C2D91" vertex="1" parent="1">
