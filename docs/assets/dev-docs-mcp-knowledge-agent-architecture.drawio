        <mxCell id="skillset" value="Skillset: skillset-documents&#10;&#10;1. Document Layout skill&#10;2. Split skill (heading/page-aware)&#10;3. AOAI Embedding skill (vectorizer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#5C2D91;align=left;verticalAlign=middle;arcSize=12;spacing=8" vertex="1" parent="1">
