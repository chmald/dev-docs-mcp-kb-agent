        </mxCell>
        <mxCell id="key_vault" value="Key Vault&#10;admin/query key" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;" vertex="1" parent="1">
          <mxGeometry x="1100" y="670" width="64" height="64" as="geometry" />
