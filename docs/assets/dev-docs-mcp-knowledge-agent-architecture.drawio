        <mxCell id="title" value="Developer Docs MCP Knowledge Base &#8212; Reference Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#323130" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="AI Search Knowledge Base exposed as an MCP endpoint (native + custom fallback) for direct GitHub Copilot / VS Code consumption" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#605E5C" vertex="1" parent="1">
