        </mxCell>
        <mxCell id="index_schema_note" value="content &#183; contentVector &#183;&#10;sourceDocument &#183; pageNumber &#183;&#10;sectionHeading &#183; sourceUri&#10;&#10;Semantic ranker + hybrid&#10;(keyword + vector) search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6" vertex="1" parent="1">
          <mxGeometry x="690" y="560" width="320" height="140" as="geometry" />
        </mxCell>

        <!-- ============ Tier 4 — Agent / MCP surface ============ -->
        <mxCell id="know_agent" value="&#129504; AI Search Knowledge Base&#10;(agentic retrieval &#8212; query planning&#10;+ synthesis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#5C2D91;align=center;verticalAlign=middle;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="1100" y="170" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="seam_note" value="DUAL MCP EXPOSURE&#10;&#10;Native = zero custom code (primary)&#10;Fallback = guarantees a working demo&#10;if the native preview isn't enabled&#10;on your Search tier/region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=3;fontStyle=1;spacing=8" vertex="1" parent="1">
          <mxGeometry x="1100" y="270" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mcp_native" value="Native MCP endpoint&#10;POST /knowledgebases/name/mcp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#5C2D91;align=center;verticalAlign=middle;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="1100" y="400" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="preview_warn" value="&#9888; Preview capability &#8212; verify&#10;exact path / API version /&#10;auth mode at deployment time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;fontSize=10;fontColor=#A4262C;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="480" width="290" height="80" as="geometry" />
        </mxCell>
