          <mxGeometry x="1600" y="170" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mcp_json_note" value="Workspace .vscode/mcp.json&#10;points at native or fallback&#10;endpoint.&#10;&#10;Team-committed; no per-dev&#10;secret hardcoded in the file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#036C70;fontSize=10;fontColor=#323130;align=left;verticalAlign=top;arcSize=8;strokeWidth=2;spacing=6" vertex="1" parent="1">
          <mxGeometry x="1560" y="290" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- ============ Bottom decision strip ============ -->
        <mxCell id="decisions" value="KEY LOCKED DECISIONS &#8212; Foundry multi-service consolidation (one resource for Document Intelligence + Azure OpenAI) &#183; Dual MCP exposure (native primary, custom fallback) so the demo works even where the preview surface isn't enabled &#183; GitHub Copilot / VS Code as the sole v1 consumption surface. Full rationale: 01-architecture.md &#167; Locked decisions &#8212; rationale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#323130;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;arcSize=8;strokeWidth=2;spacing=10" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1790" height="100" as="geometry" />
        </mxCell>

