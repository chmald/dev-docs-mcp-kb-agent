        <mxCell id="n107" value="&lt;b&gt;Why both B and C&lt;/b&gt;&lt;br&gt;A golden set that only checks which document came back cannot detect a degraded passage. C tests retrieval; B tests what is actually in the index. You need both." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="820" height="70" as="geometry"/></mxCell>
        <mxCell id="i108" value="i" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="32" y="954" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="n109" value="&lt;b&gt;Don&#x27;t claim more than the record&lt;/b&gt;&lt;br&gt;azd up, the repository export and the scripted walkthrough were validated offline only. Run them against your own subscription and record the result before quoting them to a customer." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFF7F0;strokeColor=#CA5010;strokeWidth=1.5;dashed=1;spacingLeft=44;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="860" y="930" width="820" height="70" as="geometry"/></mxCell>
        <mxCell id="i110" value="i" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="872" y="954" width="22" height="22" as="geometry"/></mxCell>
