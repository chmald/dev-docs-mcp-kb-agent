<mxfile host="Electron" version="26.0.0"><diagram id="mcp-vs-wrapper" name="MCP endpoint vs wrapper"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1090" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="-6" width="935" height="6" as="geometry"/></mxCell><mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="955" y="-6" width="725" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Native Knowledge Base MCP endpoint vs optional custom wrapper&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Same job, two ways to expose the knowledge base to Copilot: the native endpoint is the default; the wrapper is optional. Source: docs/06-mcp-endpoint-and-fallback-server.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1660" height="26" as="geometry"/></mxCell><mxCell id="laneL" value="Native Knowledge Base MCP endpoint" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="810" as="geometry"/></mxCell><mxCell id="laneR" value="Custom MCP wrapper: Container Apps or local stdio" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#605E5C;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="680" height="810" as="geometry"/></mxCell><mxCell id="laneL__tag0" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="649" y="91" width="61" height="18" as="geometry"/></mxCell><mxCell id="laneL__tag1" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="584" y="91" width="61" height="18" as="geometry"/></mxCell><mxCell id="laneR__tag0" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1581" y="91" width="69" height="18" as="geometry"/></mxCell><mxCell id="l0" value="&lt;b&gt;Inside Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The knowledge base serves /knowledgebases/{kb}/mcp on the search service; API 2026-05-01-preview&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="640" height="82" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Your FastMCP server&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;scripts/mcp_fallback_server.py on Azure Container Apps, or local stdio&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="156" width="640" height="82" as="geometry"/></mxCell><mxCell id="c0" value="Where it runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="156" width="220" height="82" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;Streamable HTTP, JSON-RPC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;initialize, tools/list, tools/call&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="248" width="640" height="82" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Streamable HTTP or stdio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;streamable-http on port 8080 on Container Apps; stdio when run locally&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="248" width="640" height="82" as="geometry"/></mxCell><mxCell id="c1" value="Protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="248" width="220" height="82" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;knowledge_base_retrieve&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;A single tool; queries is a 1-item array of max 400 characters&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="640" height="82" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;retrieve_documents&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Registered with corpus.mcpToolName and mcpToolDescription, for example retrieve_technical_docs&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="640" height="82" as="geometry"/></mxCell><mxCell id="c2" value="Tool exposed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="220" height="82" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;api-key header from inputs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Bearer is recommended: Entra scope https://search.azure.com/.default, Search Index Data Reader, expires roughly hourly&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="640" height="82" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;No key in the client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;https://${input:mcpServerFqdn}/mcp; the Search endpoint and key are Key Vault-referenced secrets in the app&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="432" width="640" height="82" as="geometry"/></mxCell><mxCell id="c3" value="Client authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="432" width="220" height="82" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;KB retrieve inside Search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Returns grounded text with per-chunk citations&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="524" width="640" height="82" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Fallback chain&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Native MCP, then KB retrieve, then raw hybrid + semantic search on idx-documents-hybrid&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="524" width="640" height="82" as="geometry"/></mxCell><mxCell id="c4" value="Retrieval path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="524" width="220" height="82" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;Zero custom code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;post_deploy_search.py --check-mcp-endpoint records mcpEndpointAvailability: native or wrapper-required&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="616" width="640" height="82" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;deploy.ps1 -DeployFallbackServer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;deploy_mcp_server.ps1 runs az acr build (no local Docker); FQDN saved in demo-ids.local.json&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="616" width="640" height="82" as="geometry"/></mxCell><mxCell id="c5" value="Setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="616" width="220" height="82" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;Default for the demo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Unless the check says wrapper-required (/mcp 404 or FeatureNotEnabled)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="708" width="640" height="82" as="geometry"/></mxCell><mxCell id="r6" value="&lt;b&gt;You need more control&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Token-lifecycle management, custom pre/post-processing, IP allowlisting, future multi-tool federation&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="708" width="640" height="82" as="geometry"/></mxCell><mxCell id="c6" value="Choose it when" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="708" width="220" height="82" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;Nothing extra&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The search service and knowledge base you already run; no code or container&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="640" height="82" as="geometry"/></mxCell><mxCell id="r7" value="&lt;b&gt;A Container App and its image&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Plus its secrets; a wrapper 401 means the Key Vault secret or key was rotated&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="640" height="82" as="geometry"/></mxCell><mxCell id="c7" value="What you operate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1DFDD;strokeColor=#201F1E;strokeWidth=1.5;fontSize=13;fontColor=#323130;align=center;verticalAlign=middle;arcSize=10;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="800" width="220" height="82" as="geometry"/></mxCell><mxCell id="reco" value="&lt;b&gt;Recommendation: use the native Knowledge Base MCP endpoint by default&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Deploy the wrapper only when the endpoint check reports wrapper-required, or when you need token-lifecycle management, custom pre/post-processing, IP allowlisting or multi-tool federation. The native endpoint is on a PREVIEW API, so say so to the customer.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=2.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="1620" height="84" as="geometry"/></mxCell><mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="60" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_DEFAULT" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="90" y="1031" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_DEFAULT" value="the path the demo takes by default" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="157" y="1030" width="219" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_PREVIEW" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="390" y="1031" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_PREVIEW" value="preview API or feature: say so to the customer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="457" y="1030" width="293" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_OPTIONAL" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="764" y="1031" width="69" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_OPTIONAL" value="not required for the demo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="839" y="1030" width="164" height="20" as="geometry"/></mxCell><mxCell id="rs_lx0" value="" style="rounded=1;arcSize=20;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1017" y="1033" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt0" value="differs between the options" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1049" y="1030" width="177" height="20" as="geometry"/></mxCell><mxCell id="rs_lx1" value="" style="rounded=1;arcSize=20;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="1033" width="26" height="14" as="geometry"/></mxCell><mxCell id="rs_lxt1" value="recommendation" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1272" y="1030" width="97" height="20" as="geometry"/></mxCell><mxCell id="rs_footer" value="Developer Docs MCP Knowledge Agent | native MCP endpoint vs optional wrapper | v1.2.1 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="1660" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>