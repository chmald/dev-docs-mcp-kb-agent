        </mxCell>
        <mxCell id="cfg" value="&lt;b&gt;azd env set …&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;AZURE_LOCATION · AZURE_SUBSCRIPTION_ID&lt;br&gt;AZURE_TENANT_ID · optional overrides&lt;br&gt;→ .azure/&amp;lt;env&amp;gt;/.env&lt;/font&gt;" vertex="1" parent="1" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;dashed=1;iconKey=gear;image=data:image/svg+xml,;">
