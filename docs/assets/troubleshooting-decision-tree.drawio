<mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="-6" width="1100" height="6" as="geometry"/></mxCell><mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="-6" width="860" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Troubleshooting 3 of 3 — retrieval, MCP endpoint and Copilot: where does the answer path break?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1960" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Follow the answer path left to right: index and retrieval, then the MCP endpoint, then the VS Code client and answer quality." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1960" height="26" as="geometry"/></mxCell><mxCell id="col0" value="Index and retrieval (§ 3, § 7)  ▸ START HERE" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="620" height="740" as="geometry"/></mxCell><mxCell id="d00" value="Index is empty after the indexer run?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#323130;fontFamily=Segoe UI;spacing=2;spacingLeft=40;spacingRight=40;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="270" height="140" as="geometry"/></mxCell><mxCell id="l00" value=