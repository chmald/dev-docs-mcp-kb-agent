;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=blob-block;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1660" y="585" width="270" height="110" as="geometry"/></mxCell><mxCell id="ey22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#107C10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d22" target="l22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ey22_lbl" value="Yes" vertex="1" connectable="0" parent="ey22" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nomatch" value="&lt;b&gt;No match: continue to § 8&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Diagnostic toolbox, then § 9 when to escalate&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDEBE9;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1410" y="760" width="300" height="64" as="geometry"/></mxCell><mxCell id="enm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#A4262C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d22" target="nomatch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="enm_lbl" value="No" vertex="1" connectable="0" parent="enm" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;labelBackgroundColor=#ffffff;fontFamily=Segoe UI;"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="howto" value="&lt;b&gt;How to read:&lt;/b&gt; start at the top-left diamond (START HERE) and take the branch that matches your symptom. Yes leads to the product and the fix with its docs/05 section; No drops to the next question, and the last No of a column continues in the next column. Diamonds quote the real error text from docs/05-troubleshooting.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="856" width="1180" height="50" as="geometry"/></mxCell><mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="924" width="60" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_PREVIEW" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="90" y="925" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_PREVIEW" value="preview API or feature: say so to the customer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="157" y="924" width="293" height="20" as="geometry"/></mxCell><mxCell id="rs_lx0" value="" style="rounded=0;fillColor=#107C10;strokeColor=n