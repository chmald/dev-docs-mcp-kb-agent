<mxfile host="Electron" version="26.0.0"><diagram id="copilot-client-flow" name="Copilot MCP client flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="875" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rs_bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="-6" width="935" height="6" as="geometry"/></mxCell><mxCell id="rs_bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="955" y="-6" width="725" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;From VS Code agent mode to a cited answer&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="How GitHub Copilot reaches the knowledge base through the native MCP endpoint, and how a team shares the setup. Source: docs/07-github-copilot-mcp-client-setup.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#605E5C;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1660" height="26" as="geometry"/></mxCell><mxCell id="pathA" value="Client request path" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1620" height="300" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;VS Code agent mode&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;GitHub Copilot in agent mode decides when to call the MCP tool&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="250" height="130" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;.vscode/mcp.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;type: http; URL uses ${input:searchServiceName}; headers api-key from inputs (promptString, password: true)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="390" y="150" width="250" height="130" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;AI Search knowledge base endpoint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;/knowledgebases/kb-hybrid/mcp?api-version=2026-05-01-preview over Streamable HTTP&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="250" height="130" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;knowledge_base_retrieve&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The single tool the endpoint exposes; queries is a 1-item array, max 400 characters&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="250" height="130" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Cited answer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Grounded text with per-chunk citations, shown in Copilot Chat&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=media-file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="250" height="130" as="geometry"/></mxCell><mxCell id="a2__tag0" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="899" y="141" width="61" height="18" as="geometry"/></mxCell><mxCell id="a2__tag1" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="834" y="141" width="61" height="18" as="geometry"/></mxCell><mxCell id="ea0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea0_num" value="1" vertex="1" connectable="0" parent="ea0" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea1_num" value="2" vertex="1" connectable="0" parent="ea1" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea2_num" value="3" vertex="1" connectable="0" parent="ea2" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ea3_num" value="4" vertex="1" connectable="0" parent="ea3" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="sn0" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="322" width="22" height="22" as="geometry"/></mxCell><mxCell id="st0" value="VS Code loads .vscode/mcp.json and prompts for the inputs: search service name and API key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7E0F4;strokeWidth=1;fontSize=13;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="88" y="312" width="357" height="64" as="geometry"/></mxCell><mxCell id="sn1" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="458" y="322" width="22" height="22" as="geometry"/></mxCell><mxCell id="st1" value="A Streamable HTTP request goes to /knowledgebases/kb-hybrid/mcp with the api-key header." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7E0F4;strokeWidth=1;fontSize=13;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="486" y="312" width="357" height="64" as="geometry"/></mxCell><mxCell id="sn2" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="856" y="322" width="22" height="22" as="geometry"/></mxCell><mxCell id="st2" value="Agent mode calls knowledge_base_retrieve with queries: a 1-item array of max 400 characters." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7E0F4;strokeWidth=1;fontSize=13;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="884" y="312" width="357" height="64" as="geometry"/></mxCell><mxCell id="sn3" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1254" y="322" width="22" height="22" as="geometry"/></mxCell><mxCell id="st3" value="The endpoint returns grounded text with per-chunk citations; Copilot answers with them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7E0F4;strokeWidth=1;fontSize=13;fontColor=#323130;align=left;verticalAlign=top;arcSize=4;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1282" y="312" width="357" height="64" as="geometry"/></mxCell><mxCell id="pathB" value="Team distribution path" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1620" height="200" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;Commit .vscode/mcp.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;The file holds ${input:...} prompts, never a key&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=commit;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="485" width="340" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Shared repository&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Update the file once and everyone picks it up on pull&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="473" y="485" width="340" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Each developer pulls&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Gets the updated file on pull; each developer needs their own credential&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="886" y="485" width="340" height="110" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Key stays local&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;inputs prompt each developer for their own credential, kept in VS Code secret storage&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1299" y="485" width="340" height="110" as="geometry"/></mxCell><mxCell id="eb0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5C2D91;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb0_num" value="A" vertex="1" connectable="0" parent="eb0" style="ellipse;html=1;aspect=fixed;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5C2D91;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb1_num" value="B" vertex="1" connectable="0" parent="eb1" style="ellipse;html=1;aspect=fixed;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5C2D91;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eb2_num" value="C" vertex="1" connectable="0" parent="eb2" style="ellipse;html=1;aspect=fixed;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Segoe UI;"><mxGeometry x="0.0" y="0" width="22" height="22" relative="1" as="geometry"><mxPoint x="-11" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="c0" value="&lt;b&gt;Auth variants&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Bearer token: Entra scope https://search.azure.com/.default, Search Index Data Reader, expires roughly hourly. Wrapper: https://${input:mcpServerFqdn}/mcp with no key.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=key-vault;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="520" height="130" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Verify in VS Code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Reload Window, switch to agent mode, run MCP: List Servers and MCP: Show Output. For 401/403 run MCP: Reset Server Auth.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="520" height="130" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Where it does not carry over&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Local stdio is for single-developer testing only. Agent Host mode does not forward ${input:...} the same way: use .mcp.json at the repo root or ~/.copilot/mcp-config.json.&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1140" y="640" width="520" height="130" as="geometry"/></mxCell><mxCell id="rs_legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="60" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_PREVIEW" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="90" y="801" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_PREVIEW" value="preview API or feature: say so to the customer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="157" y="800" width="293" height="20" as="geometry"/></mxCell><mxCell id="rs_lg_DEFAULT" value="DEFAULT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="464" y="801" width="61" height="18" as="geometry"/></mxCell><mxCell id="rs_lgt_DEFAULT" value="the path the demo takes by default" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="531" y="800" width="219" height="20" as="geometry"/></mxCell><mxCell id="rs_lx0" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="764" y="799" width="22" height="22" as="geometry"/></mxCell><mxCell id="rs_lxt0" value="request step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="792" y="800" width="85" height="20" as="geometry"/></mxCell><mxCell id="rs_lx1" value="A" style="ellipse;html=1;aspect=fixed;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="891" y="799" width="22" height="22" as="geometry"/></mxCell><mxCell id="rs_lxt1" value="team step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="919" y="800" width="67" height="20" as="geometry"/></mxCell><mxCell id="rs_footer" value="Developer Docs MCP Knowledge Agent | Copilot MCP client flow | v1.2.1 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="834" width="1660" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>